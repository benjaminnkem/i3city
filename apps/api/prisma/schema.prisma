generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_CONFIRMATION
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  WHATSAPP
  PAYSTACK
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model AdminUser {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String      @default("")
  price          Int
  compareAtPrice Int?
  stock          Int         @default(0)
  sku            String?     @unique
  brand          String?
  images         String[]
  featured       Boolean     @default(false)
  active         Boolean     @default(true)
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId])
  @@index([active, featured])
}

model Order {
  id             String        @id @default(cuid())
  code           String        @unique
  customerName   String
  phone          String
  email          String?
  address        String
  city           String
  state          String
  note           String?
  items          OrderItem[]
  events         OrderEvent[]
  subtotal       Int
  shippingFee    Int
  total          Int
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(UNPAID)
  status         OrderStatus
  paystackRef    String?       @unique
  paidAt         DateTime?
  courier        String?
  trackingNumber String?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int
  quantity  Int
  image     String?
}

model ShippingRate {
  id      String  @id @default(cuid())
  state   String  @unique
  fee     Int
  etaDays String?
}

model StoreSettings {
  id                 Int     @id @default(1)
  storeName          String  @default("i3City")
  whatsappNumber     String
  supportEmail       String?
  address            String?
  openingHours       String?
  bankDetails        String?
  defaultShippingFee Int     @default(5000)
  freeShippingOver   Int?
  paystackEnabled    Boolean @default(false)
}
